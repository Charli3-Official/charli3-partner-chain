+    /// It will check for underflow/overflow and list size limitations (>0) and return None in that cases.
+    fn calculate_median(sorted_integers: Vec<u32>) -> Option<u32> {
+        match sorted_integers.as_slice() {
+            [] => None,
+            [x] => Some(*x),
